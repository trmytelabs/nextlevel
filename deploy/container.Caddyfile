# Web server inside the production image (see Dockerfile). Plain HTTP on :8080: HTTPS, HSTS, compression and the
# Cloudflare-only rule live in the VPS's front Caddy. App-specific headers and caching stay here, versioned with the code.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Three.js + Web Audio + Google Fonts; no inline scripts in the built page.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# only Vite's content-hashed output is immutable; song.mp3, models/*.glb, textures, icons and og.png keep their
	# names when replaced, so a year-long immutable cache would pin returning visitors to the old file
	@static path /assets/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	@media path *.mp3 *.glb *.jpg *.png *.json
	header @media Cache-Control "public, max-age=3600"
	@html path / /index.html /manifest.webmanifest /version.txt
	header @html Cache-Control "no-cache"

	# healthcheck for Docker and the deploy script's automatic rollback
	handle /health {
		respond "ok" 200
	}
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
